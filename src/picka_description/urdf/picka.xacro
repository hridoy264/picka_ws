  <axis xyz="0.0 0.241922 -0.970296"/>
  <limit upper="0.0" lower="-0.523599" effort="100" velocity="2.0"/>
  <mimic joint="right_gripper_joint" multiplier="-1.0" offset="0.0"/>
  <dynamics damping="0.05" friction="0.02"/>
</joint>

<joint name="base_joint" type="revolute">
  <origin xyz="0.0 0.0 0.0675" rpy="0 0 0"/>
  <parent link="stepper_1"/>
  <child link="bracket_1"/>
  <axis xyz="0.0 0.0 1.0"/>
  <limit upper="2.792527" lower="-2.792527" effort="100" velocity="1.0"/>
  <dynamics damping="0.25" friction="0.08"/>
</joint>

