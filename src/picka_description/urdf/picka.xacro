<joint name="world_fixed_joint" type="fixed">
  <!-- The original CAD mesh bottom is 0.02 m above base_link. -->
  <origin xyz="0 0 -0.02" rpy="0 0 0"/>
  <parent link="world"/>
  <child link="base_link"/>
</joint>

<joint name="base_to_stepper_joint" type="fixed">
  <origin xyz="-0.073 0.0 0.0211" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="stepper_1"/>
</joint>

<joint name="bracket_to_shoulder_joint" type="fixed">
  <origin xyz="0.0 0.0 0.005" rpy="0 0 0"/>
  <parent link="bracket_1"/>
  <child link="shoulder_1"/>
</joint>

<joint name="shoulder_joint" type="revolute">
  <origin xyz="0.01 -0.012153 0.095" rpy="0 0 0"/>
  <parent link="shoulder_1"/>
  <child link="backarm_1"/>
  <axis xyz="-1.0 0.0 0.0"/>
  <limit upper="1.570796" lower="-0.785398" effort="100" velocity="1.5"/>
  <dynamics damping="0.20" friction="0.05"/>
</joint>

<joint name="backarm_to_forearm_servo_joint" type="fixed">
  <origin xyz="-0.085 -0.055439 0.259573" rpy="0 0 0"/>
