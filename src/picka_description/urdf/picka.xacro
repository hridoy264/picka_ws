  <parent link="wrist_1"/>
  <child link="right_gripper_1"/>
  <axis xyz="0.0 0.241922 -0.970296"/>
  <limit upper="0.523599" lower="0.0" effort="100" velocity="2.0"/>
  <dynamics damping="0.05" friction="0.02"/>
</joint>

<joint name="left_gripper_joint" type="revolute">
  <origin xyz="-0.009836 0.068351 0.006825" rpy="0 0 0"/>
